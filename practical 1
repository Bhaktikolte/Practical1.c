# Practical1.c
This is the first practical of Data Structure and Practical is about POSTFIX expression 
#include <stdio.h>

int stack[20];
int top = -1;

void push(int x)
{
    stack[++top] = x;
}

int pop()
{
    return stack[top--];
}

int main()
{
    char exp[20];
    int i, a, b;

    printf("Enter postfix expression: ");
    scanf("%s", exp);

    for (i = 0; exp[i] != '\0'; i++)
    {
        if (exp[i] >= '0' && exp[i] <= '9')
        {
            push(exp[i] - '0');
        }
        else
        {
            b = pop();
            a = pop();

            if (exp[i] == '+')
                push(a + b);
            else if (exp[i] == '-')
                push(a - b);
            else if (exp[i] == '*')
                push(a * b);
            else if (exp[i] == '/')
                push(a / b);
        }
    }

    printf("Result = %d", pop());

    return 0;
}
